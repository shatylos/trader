app:
  web_port: "8085"
  mongodb_uri: "mongodb://127.0.0.1:17027"
  ferretdb_listener_tcp: "127.0.0.1:17027"
  ferretdb_handler: "sqlite"
  ferretdb_sqlite_url: "file:var/ferretdb/"

strategy:
  - code: buy_cheap_sell_high
    id:  BTC_USDT_1
    domain: bybit_spot_demo_btc
    coin_pare: BTCUSDT
    main_currency: USDT
    trade_currency: BTC
    timeout_seconds: 10
    resolution: 30
    cost_ranges:
      - 300
      - 600
      - 900
      - 1200
    percent_ranges:
      - 7
      - 8
      - 10
      - 12
    long_term_max_price: 70000
    long_term_min_price: 10000
    long_term_percent_buffer: 10
    max_qty_diff: 1.5
    min_qty: 0.0001
    purchase_volume_precision: 6
    purchase_price_precision: 1
    commission_percent: 0.1
    minutes_to_reduce_price_range: 240
    avg_price_candle_limit: 10
    avg_price_candle_offset: 2
    manual_buy_price_before_start: 20000
    withdraw_percent: 50

  - code: fibonacci
    id:  BTC_USDT_FIBONACCI_1
    domain: bybit_derivatives_demo_btc
    enabled: 1
    verbose: 0
    telegram_notifier333: 1
    coin_pare: BTCUSDT
    main_currency: USDT
    trade_currency: BTC
    min_depo: 10
    leverage: 2
    timeout_seconds: 10
    resolution: 15
    max_candle_review: 100
    min_candle_review: 15
    prev_positions_review: 2
    long_trend_resolution: 60
    long_trend_candle_review: 168 # 24 * 7 - 1 week
    price_precision: 2
    qty_precision: 2
    min_qty: 0.01
    fib_entry_point_1: 0.618
    fib_entry_point_2: 0.5
    fib_entry_point_3: 0.382
    fib_stop_loss: -0.5
    fib_take_profit_1: 1.25
    fib_take_profit_2: 0.92
    fib_take_profit_3: 0.59
    risk_percent: 5
    ep_1_to_full_qty_percent: 10
    ep_2_to_full_qty_percent: 30
    ep_3_to_full_qty_percent: 60
    hours_to_reduce_tp_1: 24
    hours_to_reduce_tp_1_lt: 6
    hours_to_reduce_tp_2: 48
    hours_to_reduce_tp_2_lt: 12
    hours_to_reduce_tp_3: 72
    hours_to_reduce_tp_3_lt: 24
    percent_to_reduce_tp: 30
    position_too_much_time_hours: 168 # 24 * 7 - 1 week
    withdraw_percent: 50

  - id:  BTC_USDT_VWAP_REVERSION_1
    code: vwap_reversion
    domain: bybit_features_demo_btc
    enabled: 1
    verbose: 0
    telegram_notifier: 0
    coin_pare: BTCUSDT
    main_currency: USDT
    trade_currency: BTC
    min_depo: 10
    leverage: 2
    timeout_seconds: 10
    resolution: "15m"
    vwap_period: 100              # entry-tf candles used for the VWAP / bands
    long_trend_resolution: "1h"
    long_trend_candle_review: 168 # 24 * 7 - 1 week
    long_trend_candles_cache_ttl: 60
    price_precision: 2
    qty_precision: 3
    min_qty: 0.001
    entry_sigma_mult: 2.0         # enter when price is this many sigma from VWAP
    sl_sigma_mult: 3.0            # stop-loss this many sigma from VWAP (> entry)
    require_confirmation: 1       # 1: wait for candle-color reversal confirmation
    risk_percent: 2              # % of balance risked per trade (qty sizing)
    increase_resk_to_min_qty: 1
    withdraw_percent: 50

  - id:  BTC_USDT_SCALPER_1
    code: scalper
    domain: bybit_features_demo_btc
    enabled: 1
    verbose: 0
    telegram_notifier: 0
    coin_pare: BTCUSDT
    main_currency: USDT
    trade_currency: BTC
    leverage: 2
    timeout_seconds: 10
    price_precision: 2
    qty_precision: 3
    min_qty: 0.001
    risk_percent: 1               # % of balance risked per trade (qty sizing)
    increase_risk_to_min_qty: 1
    withdraw_percent: 50
    # entry (lower) timeframe
    entry_resolution: "1m"
    entry_candle_review: 150      # candles loaded for the entry indicators
    ltf_ema_period: 21            # pullback EMA on the entry timeframe
    rsi_period: 14
    rsi_momentum_level: 50        # RSI must flip through this level after the pullback
    rsi_overbought: 65            # skip long entries above this RSI (chasing)
    rsi_oversold: 35              # skip short entries below this RSI (chasing)
    atr_period: 14
    min_atr_percent: 0.05         # skip entries when ATR < this % of price (dead market)
    pullback_lookback: 5          # closed candles scanned for the pullback / RSI flip
    tp_atr_mult: 1.5              # take-profit distance in ATRs
    sl_atr_mult: 1.0              # stop-loss distance in ATRs
    # bias (higher) timeframe
    bias_resolution: "15m"
    bias_candle_review: 100       # candles loaded for the bias indicators
    bias_candles_cache_ttl: 60    # seconds to cache the bias timeframe candles
    htf_ema_fast_period: 21
    htf_ema_slow_period: 50
    require_trend_confirmation: 0 # 1: linear regression trend must not oppose the EMA bias

domain:
  bybit_spot_demo_btc:
    code: bybitSpot
    secrets:
      endpoint: https://api-testnet.bybit.com
#      endpoint: https://api.bybit.com
      key: 123
      pass: asdfasdfasdf
      verbose: 0

  bybit_derivatives_demo_btc:
    code: bybitMargin
    secrets:
      endpoint: https://api-testnet.bybit.com
#      endpoint: https://api.bybit.com
      key: 123
      pass: asdfasdfasdf
      verbose: 0
